# Optional local dashboard port. REST always binds to 127.0.0.1.
H2A_PORT=8765

# OPTIONAL: only enabled when running `--heal-selectors --ai-heal` or when
# explicitly setting H2A_HEAL_SELECTORS=1 and H2A_AI_HEAL=1 for MCP.
# Metadata (element IDs/names/labels) may be sent to this provider.
# Never commit actual credentials or .env files.
H2A_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
H2A_AI_MODEL=gpt-4.1-mini
H2A_AI_API_KEY=

# MCP writes are blocked unless your MCP client asks for permission AND this
# explicit environment variable is set to 1.
H2A_ALLOW_WRITE=0
H2A_HEAL_SELECTORS=0
H2A_AI_HEAL=0
