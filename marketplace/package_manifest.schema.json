{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human2API Signed Package Manifest",
  "type": "object",
  "required": [
    "schema",
    "tool_id",
    "version",
    "publisher_id",
    "workflow_sha256",
    "public_key",
    "signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "h2a-package-manifest-v1"
    },
    "tool_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publisher_id": {
      "type": "string"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "public_key": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  }
}
