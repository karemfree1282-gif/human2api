{
  "schemaVersion": "0.5",
  "name": "Android Companion Scoped Settings Search",
  "description": "Android AccessibilityService workflow scoped to com.android.settings with Unicode input.",
  "version": "1.0.0",
  "target": "android-companion",
  "mode": "read",
  "allowedPackages": ["com.android.settings"],
  "inputs": {
    "query": {
      "type": "string",
      "description": "Settings search term",
      "required": true,
      "sensitive": false,
      "default": "البطارية Battery"
    }
  },
  "steps": [
    {
      "id": "step_1",
      "action": "click",
      "packageName": "com.android.settings",
      "resourceId": "com.android.settings:id/search_action_bar",
      "role": "button",
      "name": "Search settings"
    },
    {
      "id": "step_2",
      "action": "type_text",
      "packageName": "com.android.settings",
      "resourceId": "android:id/search_src_text",
      "role": "textbox",
      "name": "Search query",
      "text": "${input:query}"
    }
  ],
  "assertions": [
    {
      "type": "assert_text",
      "selector": "android:id/search_src_text",
      "expected": "${input:query}",
      "match": "contains"
    }
  ]
}
