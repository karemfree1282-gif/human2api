{
  "$schema": "../schemas/workflow.schema.json",
  "schemaVersion": 1,
  "name": "create_invoice",
  "description": "Create and verify a fake invoice in the local sandbox, then download a text receipt",
  "startUrl": "http://127.0.0.1:8765/demo",
  "permissions": "write",
  "allowedHosts": [
    "127.0.0.1"
  ],
  "inputs": {
    "customer_name": {
      "type": "string",
      "description": "Customer to bill",
      "required": true
    },
    "amount": {
      "type": "number",
      "description": "Amount in USD",
      "required": true
    }
  },
  "steps": [
    {
      "action": "fill",
      "selector": "#customer-name",
      "value": "{{customer_name}}",
      "alternatives": [
        "input[name=\"customer_name\"]"
      ]
    },
    {
      "action": "fill",
      "selector": "#invoice-amount",
      "value": "{{amount}}",
      "alternatives": [
        "input[name=\"amount\"]"
      ]
    },
    {
      "action": "click",
      "selector": "#make-invoice"
    },
    {
      "action": "assert_text",
      "selector": "#invoice-status",
      "text": "Invoice created successfully"
    },
    {
      "action": "extract_text",
      "selector": "#invoice-summary",
      "as": "confirmation"
    },
    {
      "action": "download",
      "selector": "#download-invoice",
      "filename": "demo-invoice.txt"
    }
  ]
}
