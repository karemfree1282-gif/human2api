{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karemfree1282-gif/human2api/raw/main/schemas/workflow.schema.json",
  "title": "Human2API Workflow v1 (browser / desktop / Android)",
  "description": "Portable, non-executable workflow definition compatible with Human2API 0.2",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "description",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "startUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "permissions": {
      "enum": [
        "read",
        "write"
      ],
      "default": "write"
    },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*$"
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 80,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "boolean"
            ],
            "default": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "secret": {
            "type": "boolean",
            "default": false
          },
          "default": {}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "secret": {
                  "const": true
                }
              },
              "required": [
                "secret"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "number"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "default": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "enum": [
              "assert_image",
              "assert_text",
              "check",
              "click",
              "double_click",
              "download",
              "drag",
              "extract_text",
              "fill",
              "hotkey",
              "hover",
              "input_text",
              "keyevent",
              "move",
              "navigate",
              "press",
              "screenshot",
              "scroll",
              "select",
              "swipe",
              "switch_tab",
              "tap",
              "tap_text",
              "type_text",
              "wait",
              "wait_ms"
            ]
          },
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "alternatives": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000
          },
          "value": {
            "type": "string"
          },
          "checked": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "text": {
            "type": "string"
          },
          "as": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "url": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "pattern": "^[^./\\\\][^/\\\\]*$",
            "maxLength": 128
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "x2": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "y2": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "delta": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "durationMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 120000
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "targetSelector": {
            "type": "string",
            "minLength": 1
          },
          "frame": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "textHint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,20}$"
            }
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          },
          "by": {
            "enum": [
              "text",
              "resource-id",
              "content-desc"
            ]
          },
          "image": {
            "type": "string",
            "pattern": "^[^./\\\\][^/\\\\]*$",
            "maxLength": 128
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "fill",
                    "select",
                    "check",
                    "wait",
                    "download",
                    "hover",
                    "press",
                    "drag",
                    "tap_text",
                    "extract_text"
                  ]
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "selector"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "fill",
                    "select"
                  ]
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "check"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "checked"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "navigate"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "assert_text"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "extract_text"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "as"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "type_text",
                    "input_text"
                  ]
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "swipe"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "x2",
                "y2"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "hotkey"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "keys"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "press",
                    "keyevent"
                  ]
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "key"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "switch_tab"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "index"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "assert_image"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "image"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "wait_ms"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "durationMs"
              ]
            }
          }
        ]
      }
    },
    "target": {
      "enum": [
        "browser",
        "desktop",
        "android"
      ],
      "default": "browser"
    },
    "deviceSerial": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "appPackage": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "target"
          ]
        }
      },
      "then": {
        "required": [
          "startUrl"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "browser"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "properties": {
                "action": {
                  "enum": [
                    "assert_text",
                    "check",
                    "click",
                    "download",
                    "drag",
                    "extract_text",
                    "fill",
                    "hover",
                    "navigate",
                    "press",
                    "screenshot",
                    "scroll",
                    "select",
                    "switch_tab",
                    "wait",
                    "wait_ms"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "desktop"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "properties": {
                "action": {
                  "enum": [
                    "assert_image",
                    "click",
                    "double_click",
                    "hotkey",
                    "move",
                    "press",
                    "screenshot",
                    "scroll",
                    "type_text",
                    "wait_ms"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "android"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "properties": {
                "action": {
                  "enum": [
                    "assert_text",
                    "extract_text",
                    "input_text",
                    "keyevent",
                    "screenshot",
                    "swipe",
                    "tap",
                    "tap_text",
                    "wait_ms"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "browser"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "required": [
          "startUrl"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "enum": [
              "desktop",
              "android"
            ]
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "startUrl"
              ]
            },
            {
              "required": [
                "allowedHosts"
              ]
            }
          ]
        }
      }
    }
  ]
}
