{
    servers {
        timeouts {
            read_header 10s
            read_body 20s
            write 30s
            idle 60s
        }
    }
}
{$H2A_DOMAIN} {
    request_body {
        max_size 768KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy registry:8770
}
